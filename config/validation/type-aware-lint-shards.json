{
  "schemaVersion": 1,
  "execution": {
    "concurrency": 1,
    "reason": "CrawDevAi has 15 GiB RAM and hosts Primary and Rescue; type-aware shards run serially."
  },
  "eligibleRoots": [
    "src",
    "ui",
    "packages",
    "extensions",
    "scripts",
    "test"
  ],
  "shards": [
    {
      "id": "core-agents-embedded",
      "owner": "agent embedded runtime",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "src/agents/embedded-agent-runner"
      ]
    },
    {
      "id": "core-agents-tools",
      "owner": "agent tools",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "src/agents/tools"
      ]
    },
    {
      "id": "core-agents-sessions",
      "owner": "agent sessions",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "src/agents/sessions"
      ]
    },
    {
      "id": "core-agents-cli",
      "owner": "agent CLI runtimes",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "src/agents/cli-runner"
      ]
    },
    {
      "id": "core-agents-rest",
      "owner": "remaining agent runtime",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "src/agents"
      ],
      "excludePrefixes": [
        "src/agents/embedded-agent-runner",
        "src/agents/tools",
        "src/agents/sessions",
        "src/agents/cli-runner"
      ]
    },
    {
      "id": "core-auto-reply",
      "owner": "auto-reply",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "src/auto-reply"
      ]
    },
    {
      "id": "core-gateway",
      "owner": "gateway",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "src/gateway"
      ]
    },
    {
      "id": "core-plugin-platform",
      "owner": "plugin platform and SDK",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "src/plugins",
        "src/plugin-sdk"
      ]
    },
    {
      "id": "core-channels",
      "owner": "channel platform",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "src/channels"
      ]
    },
    {
      "id": "core-system-agent",
      "owner": "system-agent control plane",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "src/system-agent"
      ]
    },
    {
      "id": "core-config",
      "owner": "configuration",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "src/config"
      ]
    },
    {
      "id": "core-infra",
      "owner": "infrastructure",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "src/infra"
      ]
    },
    {
      "id": "core-security",
      "owner": "security and secrets",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "src/security",
        "src/secrets"
      ]
    },
    {
      "id": "core-commands-cli",
      "owner": "commands and CLI",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "src/commands",
        "src/cli"
      ]
    },
    {
      "id": "core-automation",
      "owner": "automation, tasks, and skills",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "src/cron",
        "src/skills",
        "src/tasks",
        "src/hooks",
        "src/commitments",
        "src/boards"
      ]
    },
    {
      "id": "core-media",
      "owner": "media and realtime capabilities",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "src/media",
        "src/media-understanding",
        "src/media-generation",
        "src/image-generation",
        "src/image-ops",
        "src/video-generation",
        "src/music-generation",
        "src/talk",
        "src/tts",
        "src/realtime-transcription",
        "src/meeting-bot"
      ]
    },
    {
      "id": "core-src-rest",
      "owner": "remaining core source",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "src"
      ],
      "excludePrefixes": [
        "src/agents",
        "src/auto-reply",
        "src/gateway",
        "src/plugins",
        "src/plugin-sdk",
        "src/channels",
        "src/system-agent",
        "src/config",
