      ]
    },
    {
      "id": "extensions-qa-platform",
      "owner": "QA and browser platform extensions",
      "tsconfig": "config/tsconfig/oxlint.extensions.json",
      "includePrefixes": [
        "extensions/qa-lab",
        "extensions/browser",
        "extensions/diagnostics-otel",
        "extensions/qa-channel",
        "extensions/file-transfer",
        "extensions/diffs"
      ]
    },
    {
      "id": "extensions-rest",
      "owner": "remaining extensions",
      "tsconfig": "config/tsconfig/oxlint.extensions.json",
      "includePrefixes": [
        "extensions"
      ],
      "excludePrefixes": [
        "extensions/discord",
        "extensions/telegram",
        "extensions/slack",
        "extensions/matrix",
        "extensions/whatsapp",
        "extensions/qqbot",
        "extensions/feishu",
        "extensions/msteams",
        "extensions/imessage",
        "extensions/mattermost",
        "extensions/signal",
        "extensions/line",
        "extensions/googlechat",
        "extensions/zalouser",
        "extensions/zalo",
        "extensions/nextcloud-talk",
        "extensions/clickclack",
        "extensions/nostr",
        "extensions/irc",
        "extensions/twitch",
        "extensions/synology-chat",
        "extensions/tlon",
        "extensions/sms",
        "extensions/teams-meetings",
        "extensions/zoom-meetings",
        "extensions/google-meet",
        "extensions/codex",
        "extensions/openai",
        "extensions/xai",
        "extensions/google",
        "extensions/anthropic",
        "extensions/ollama",
        "extensions/acpx",
        "extensions/copilot",
        "extensions/github-copilot",
        "extensions/openrouter",
        "extensions/deepinfra",
        "extensions/minimax",
        "extensions/amazon-bedrock",
        "extensions/moonshot",
        "extensions/lmstudio",
        "extensions/firecrawl",
        "extensions/elevenlabs",
        "extensions/open-prose",
        "extensions/qa-lab",
        "extensions/browser",
        "extensions/diagnostics-otel",
        "extensions/qa-channel",
        "extensions/file-transfer",
        "extensions/diffs"
      ]
    },
    {
      "id": "scripts",
      "owner": "repository tooling",
      "tsconfig": "config/tsconfig/oxlint.scripts.json",
      "includePrefixes": [
        "scripts"
      ]
    },
    {
      "id": "tests-tooling",
      "owner": "repository tooling tests",
      "tsconfig": "test/tsconfig/tsconfig.test.root.json",
      "includePrefixes": [
        "test/scripts"
      ],
      "allowRules": [
        "typescript/unbound-method",
        "typescript/no-base-to-string",
        "eslint/no-promise-executor-return",
        "eslint/no-implicit-coercion",
        "eslint/no-shadow",
        "unicorn/no-array-sort",
        "typescript/require-array-sort-compare",
        "typescript/restrict-template-expressions",
        "oxc/no-map-spread",
        "typescript/no-unnecessary-template-expression",
        "unicorn/no-unreadable-array-destructuring",
        "eslint/no-regex-spaces",
        "typescript/prefer-promise-reject-errors",
        "typescript/no-unnecessary-type-conversion",
        "typescript/no-unnecessary-boolean-literal-compare",
        "eslint/no-useless-escape",
        "unicorn/prefer-structured-clone",
        "eslint/no-useless-assignment",
        "unicorn/no-array-reverse",
        "typescript/no-implied-eval"
      ],
      "allowReason": "Inherited test-only idioms and deliberate violation fixtures were outside the historical lint gate; the remaining type-aware rules are enforced without weakening existing production, extension, or script shards.",
      "tracking": "docs/development/opencraw-validation.md#test-root-lint-policy",
      "reportUnusedDisableDirectives": false
    },
    {
      "id": "tests-runtime",
      "owner": "root runtime and integration tests",
      "tsconfig": "test/tsconfig/tsconfig.test.root.json",
      "includePrefixes": [
        "test"
      ],
      "excludePrefixes": [
        "test/scripts"
      ],
      "allowRules": [
        "eslint/no-promise-executor-return",
        "eslint/no-unused-vars",
        "typescript/use-unknown-in-catch-callback-variable",
        "eslint/no-useless-concat",
        "typescript/adjacent-overload-signatures",
        "eslint/no-unmodified-loop-condition",
        "typescript/unbound-method",
        "typescript/no-base-to-string",
        "eslint/no-shadow",
        "eslint/prefer-const",
        "unicorn/no-array-sort",
        "oxc/no-map-spread",
        "typescript/no-floating-promises",
        "typescript/no-unnecessary-type-arguments",
        "typescript/no-misused-promises"
      ],
      "allowReason": "Inherited test-only idioms and deliberate violation fixtures were outside the historical lint gate; the remaining type-aware rules are enforced without weakening existing production, extension, or script shards.",
      "tracking": "docs/development/opencraw-validation.md#test-root-lint-policy",
      "reportUnusedDisableDirectives": false
    }
  ]
}
