    },
    {
      "id": "extensions-model-providers",
      "owner": "model provider extensions",
      "tsconfig": "config/tsconfig/oxlint.extensions.json",
      "includePrefixes": [
        "extensions/codex",
        "extensions/openai",
        "extensions/xai",
        "extensions/google",
        "extensions/anthropic",
        "extensions/ollama",
        "extensions/acpx",
        "extensions/copilot",
        "extensions/github-copilot",
        "extensions/openrouter",
        "extensions/deepinfra",
        "extensions/minimax",
