        "src/media-generation",
        "src/image-generation",
        "src/image-ops",
        "src/video-generation",
        "src/music-generation",
        "src/talk",
        "src/tts",
        "src/realtime-transcription",
        "src/meeting-bot"
      ]
    },
    {
      "id": "core-ui",
      "owner": "Control UI",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "ui"
      ]
    },
    {
      "id": "core-packages",
      "owner": "shared packages",
      "tsconfig": "config/tsconfig/oxlint.core.json",
      "includePrefixes": [
        "packages"
      ]
    },
    {
      "id": "extensions-channel-discord-telegram",
      "owner": "Discord and Telegram extensions",
      "tsconfig": "config/tsconfig/oxlint.extensions.json",
      "includePrefixes": [
        "extensions/discord",
        "extensions/telegram"
      ]
    },
    {
      "id": "extensions-channel-collaboration",
      "owner": "collaboration channel extensions",
      "tsconfig": "config/tsconfig/oxlint.extensions.json",
      "includePrefixes": [
        "extensions/slack",
        "extensions/matrix",
        "extensions/whatsapp",
        "extensions/qqbot",
        "extensions/feishu",
        "extensions/msteams"
      ]
    },
    {
      "id": "extensions-channel-messaging",
      "owner": "messaging channel extensions",
      "tsconfig": "config/tsconfig/oxlint.extensions.json",
